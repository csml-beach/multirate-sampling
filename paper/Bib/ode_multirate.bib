@article{Gear_1965_hybrid,
	abstract = {Methods for the integration of initial value problems for the ordinary differential equation dy/dx = f(x,y) which are a combination of one step procedures (e.g. Runge-Kutta) and multistep procedures (e.g., Adams' method) are discussed. A generalization of a theorem from Henrici [3] proves that these methods converge under suitable conditions of stability and consistency. This, incidentally, is also a proof that predictor-corrector methods using a finite number of iterations converge. Four specific methods of order 4, 6, 8 and 10 have been found. Numerical comparisons of the first three of these have been made with Adams', Nordsieck's and the Runge-Kutta methods.},
	author = {C.W. Gear},
	date-added = {2011-11-28 19:50:03 -0500},
