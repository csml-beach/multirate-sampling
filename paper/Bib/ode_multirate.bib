@article{Hundsdorfer_1994,
	abstract = {Many numerical methods to solve initial value problems of the form y'=f(t,y) can be written as general linear methods. Classical convergence results for such methods are based on the Lipschitz constant and bounds for certain partial derivatives of f. For stiff problems these quantities may be very large, and consequently the classical order of convergence loses its significance. In this paper we consider bounds for the global errors which are based only on bounds for derivatives of y for linear and non-linear dissipative problems with arbitrary stiffness.},
	author = {W. Hundsdorfer},
	date-added = {2011-11-28 19:50:03 -0500},
	date-modified = {2011-11-28 19:50:03 -0500},
	doi = {10.1093/imanum/14.3.363},
	journal = {IMA Journal of Numerical Analysis},
