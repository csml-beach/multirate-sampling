@article{Prothero_1974_PR,
	abstract = {The stiffness in some systems of nonlinear differential equations is shown to be characterized by single stiff equations of the form $$y' = g'(x) + {\l}ambda \{y - g(x)\}.$$ The stability and accuracy of numerical approximations to the solution $y = g(x)$, obtained using implicit one-step integration methods, are studied. An $S$-stability property is introduced for this problem, generalizing the concept of $A$-stability. A set of stiffly accurate one-step methods is identified and the concept of stiff order is defined in the limit $\operatorname{Re}(-\lambda) \rightarrow \infty$. These additional properties are enumerated for several classes of $A$-stable one-step methods, and are used to predict the behaviour of numerical solutions to stiff nonlinear initial-value problems obtained using such methods. A family of methods based on a compromise between accuracy and stability considerations is recommended for use on practical problems.},
	author = {A. Prothero and A. Robinson},
	copyright = {Copyright {\copyright} 1974 American Mathematical Society},
	date-added = {2011-05-18 01:04:26 -0400},
	date-modified = {2013-04-15 13:27:11 +0000},
	issn = {00255718},
	journal = {Mathematics of Computation},
	language = {English},
	number = {125},
	pages = {145--162},
	publisher = {American Mathematical Society},
	title = {On the Stability and Accuracy of One-Step Methods for Solving Stiff Systems of Ordinary Differential Equations},
	volume = {28},
	year = {1974}}

