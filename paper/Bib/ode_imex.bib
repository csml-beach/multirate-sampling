	publisher = {Springer International Publishing},
	title = {Implicit--Explicit Multistep Methods for Nonlinear Convection--Diffusion Equations},
	year = {2020}}

@article{Akrivis_2003_IMEX-BDF_parabolic,
	abstract = {Implicit--explicit multistep methods for nonlinear parabolic equations were recently analyzed. If the implicit scheme is one of the backward differentiation formulae (BDF) of order up to six, then the corresponding implicit--explicit method of the same order is stable provided the stability constant is less than a specific scheme-dependent constant. Based on BDF, implicit methods are constructed such that the corresponding implicit--explicit scheme of the same order exhibits improved stability properties.},
