@inproceedings{Akrivis_2020_IMEX-LMM_convection-diffusion,
	abstract = {We construct and analyze implicit--explicit multistep schemes for nonlinear evolution convection--diffusion partial differential equations. We establish optimal order a priori error estimates. We are particularly interested in the dependence of the stability constants on the ratio between the convection and diffusion coefficients, the so-called P{\'e}clet number, and on the diffusion coefficient $\epsilon$ itself. In particular, we show that the second order implicit--explicit backward differentiation formula (BDF) admits stability constant independent of the P{\'e}clet number.},
	address = {Cham},
	author = {Akrivis, Georgios and Georgoulis, Emmanuil H.},
	booktitle = {Boundary and Interior Layers, Computational and Asymptotic Methods BAIL 2018},
	date-added = {2024-05-13 10:43:23 -0400},
