@article{Ostermann_1993_half-explicit-RK,
	abstract = {This paper introduces half-explicit Runge-Kutta methods for the solution of differential-algebraic systems of index 3. Half-explicit methods only treat the algebraic variables implicitly, hence have computational advantages compared to fully implicit schemes. For a class of partitioned methods, order conditions are derived and convergence is proved. Particular methods up to order 3 are given and a numerical experiment, illustrating the theoretical results, is included.},
